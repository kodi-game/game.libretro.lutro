msgctxt "Addon Description"
msgid "Lutro is an experimental Lua game framework for libretro inspired by LÖVE."
msgstr "Lutro je experimentální herní framework v jazyce Lua pro Libretro inspirovaný LÖVE."

# Empty string with ID 30000
msgctxt "#30001"
msgid "Mouse Input Device"
msgstr "Vstupní zařízení myši"

msgctxt "#30002"
msgid "Select the input device to manage lutro.mouse. 'Mouse' tracks relative movement, while 'Pointer' maps absolute coordinates."
msgstr "Vyberte vstupní zařízení pro ovládání lutro.mouse. „Myš“ sleduje relativní pohyb, zatímco „Ukazatel“ mapuje absolutní souřadnice."

